{
  "name": "@personal-pi/core",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable personal software delivery kernel for Personal PI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"check:protocol-isolation": "node scripts/check-protocol-isolation.mjs",
		"phase-12-level-b": "node scripts/phase-12-level-b.mjs",
		"phase-13-t13-4": "node scripts/phase-13-t13-4.mjs",
		"test": "vitest --run"
	},
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  }
}
